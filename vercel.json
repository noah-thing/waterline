{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/scan.mjs": {
      "maxDuration": 120,
      "memory": 2048,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,node_modules/@sparticuz/chromium/package.json,node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm,node_modules/nsfwjs/dist/models/mobilenet_v2/**}",
      "excludeFiles": "{node_modules/nsfwjs/dist/models/inception_v3/**,node_modules/nsfwjs/dist/models/mobilenet_v2_mid/**,testbed/**}"
    },
    "api/stats.mjs": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,node_modules/@sparticuz/chromium/package.json,node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm,node_modules/nsfwjs/dist/models/mobilenet_v2/**}",
      "excludeFiles": "{node_modules/nsfwjs/dist/models/inception_v3/**,node_modules/nsfwjs/dist/models/mobilenet_v2_mid/**,testbed/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(fonts|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}